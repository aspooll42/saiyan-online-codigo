<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Intersect.Framework</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Intersect.Framework.intersect-logo-qu.ico" />
    <EmbeddedResource Include="Intersect.Framework.intersect-logo-qu.ico" LogicalName="Intersect.Framework.intersect-logo-qu.ico" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="MessagePack.Annotations">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/MessagePack.Annotations.dll</HintPath>
    </Reference>
    <Reference Include="Hardware.Info">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Hardware.Info.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Hosting.Abstractions">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Microsoft.Extensions.Hosting.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="Serilog">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Serilog.dll</HintPath>
    </Reference>
    <Reference Include="Serilog.Extensions.Logging">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Serilog.Extensions.Logging.dll</HintPath>
    </Reference>
    <Reference Include="System.IO.Hashing">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/System.IO.Hashing.dll</HintPath>
    </Reference>
    <Reference Include="Serilog.Sinks.Console">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Serilog.Sinks.Console.dll</HintPath>
    </Reference>
    <Reference Include="Serilog.Sinks.File">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Serilog.Sinks.File.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Abstractions">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Microsoft.EntityFrameworkCore.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>