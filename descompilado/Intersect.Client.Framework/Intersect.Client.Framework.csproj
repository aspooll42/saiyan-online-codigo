<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Intersect.Client.Framework</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Intersect.Client.Framework.intersect-logo-qu.ico" />
    <None Remove="Intersect.Client.Framework.Gwen.Skin.skin-intersect.png" />
    <EmbeddedResource Include="Intersect.Client.Framework.intersect-logo-qu.ico" LogicalName="Intersect.Client.Framework.intersect-logo-qu.ico" />
    <EmbeddedResource Include="Intersect.Client.Framework.Gwen.Skin.skin-intersect.png" LogicalName="Intersect.Client.Framework.Gwen.Skin.skin-intersect.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Intersect.Framework.Core">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Intersect.Framework.Core.dll</HintPath>
    </Reference>
    <Reference Include="CommandLine">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/CommandLine.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Intersect.Framework">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Intersect.Framework.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(MSBuildThisFileDirectory)../../extraido/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>